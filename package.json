{
  "name": "parachord-desktop",
  "version": "0.9.9",
  "description": "Parachord Desktop - Multi-source music player with cross-platform resolver support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:css": "npx tailwindcss build -i tailwind-input.css -o vendor/tailwind.css --minify",
    "prebuild": "npm run build:css && node scripts/build-native.js && node scripts/build-renderer.js",
    "prebuild:mac": "npm run build:css && node scripts/build-native.js && node scripts/build-renderer.js",
    "prebuild:win": "npm run build:css && node scripts/build-renderer.js",
    "prebuild:linux": "npm run build:css && node scripts/build-renderer.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:native": "node scripts/build-native.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:playback": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/playback/",
    "test:resolver": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/resolver/",
    "test:legacy": "node tests/resolution-scheduler.test.js && node tests/youtube-resolver.test.js && node tests/browser-extension.test.js",
    "package:extension": "node scripts/package-extension.js",
    "publish:extension": "node scripts/package-extension.js && node scripts/publish-extension.js",
    "axes": "node scripts/build-axes.js",
    "axes:check": "node scripts/build-axes.js --check",
    "build:renderer": "node scripts/build-renderer.js",
    "dev:renderer": "node scripts/build-renderer.js --watch",
    "pretest": "node scripts/build-renderer.js",
    "prestart": "node scripts/build-renderer.js",
    "predev": "node scripts/build-renderer.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --allowJs --checkJs --target ES2022 --module commonjs --skipLibCheck protocol-url.js"
  },
  "keywords": [
    "music",
    "player",
    "spotify",
    "bandcamp",
    "qobuz",
    "resolver",
    "streaming",
    "electron"
  ],
  "author": {
    "name": "Jason Herskowitz",
    "email": "team@parachord.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.13.18",
    "chrome-webstore-upload-cli": "^4.0.2",
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "espree": "10.4.0",
    "jest": "^30.2.0",
    "jose": "^6.1.3",
    "prettier": "^3.9.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@jellybrick/mpris-service": "^2.1.5",
    "@xmcl/discord-rpc": "^1.1.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.8",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.1.7",
    "express": "^5.3.0",
    "music-metadata": "^12.2.2",
    "node-id3": "^0.2.6",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "com.parachord.desktop",
    "productName": "Parachord",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Parachord",
      "repo": "parachord"
    },
    "files": [
      "**/*",
      "!.DS_Store",
      "!.git",
      "!.gitignore",
      "!npm-debug.log",
      "!dist",
      "!**/*.md",
      "!**/*.map",
      "RELEASE_NOTES.md",
      "!collection.json",
      "!native",
      "!tailwind.config.js",
      "!tailwind-input.css",
      "!jest.config.js",
      "!.github",
      "!docs",
      "!tests",
      "!scripts",
      "!parachord-extension",
      "!raycast-extension",
      "!smart-links",
      "!tools/generate-link.js",
      "!tools/example-link.html",
      "!src",
      "!assets/*.png"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "mcp-stdio.js",
      "native-messaging/**",
      "plugins/**"
    ],
    "extraResources": [
      {
        "from": "resources/keys/",
        "to": "keys/",
        "filter": [
          "*.p8"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/after-sign.js",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "NSAppleMusicUsageDescription": "Parachord needs access to Apple Music to play songs from your library and subscription."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "resources/bin/darwin/",
          "to": "bin/darwin/",
          "filter": [
            "**/*"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "icon": "assets/icons/icon.icns",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo"
    }
  },
  "overrides": {
    "addons-scanner-utils": {
      "express": "^4.22.3"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
