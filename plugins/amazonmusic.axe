{
  "manifest": {
    "id": "amazonmusic",
    "name": "Amazon Music",
    "version": "1.4.2",
    "author": "Parachord Team",
    "description": "Uses Amazon's web player and this app's Widevine CDM. Does not use the Amazon Music desktop app.",
    "icon": "🎵",
    "color": "#25D1DA",
    "homepage": "https://music.amazon.com",
    "email": "support@parachord.dev"
  },
  "capabilities": {
    "resolve": true,
    "search": true,
    "stream": true,
    "browse": false,
    "urlLookup": true,
    "mobile": false
  },
  "urlPatterns": [
    "music.amazon.com/playlists/*",
    "music.amazon.com/my/playlists/*"
  ],
  "settings": {
    "requiresAuth": false,
    "authType": "none",
    "configurable": {}
  },
  "implementation": {
    "search": "async function(query, config) {\n  try {\n    if (!window.electron || !window.electron.amazonMusic) {\n      console.warn('Amazon Music: bridge not available');\n      return [];\n    }\n    var payload = query;\n    if (typeof query === 'string') {\n      if (!query.trim() || query.trim().length < 2) return [];\n      payload = query.trim();\n    } else if (!query || (!(query.title && String(query.title).trim()) && !(query.artist && String(query.artist).trim()))) {\n      return [];\n    }\n    const result = await window.electron.amazonMusic.searchTracks(payload);\n    console.log('[Amazon] resolver search', typeof payload === 'string' ? payload : payload, result && result.success, result && result.reason, result && result.tracks && result.tracks.length);\n    if (!result || !result.success) {\n      var reason = result && result.reason;\n      if (reason === 'not-ready' || reason === 'not-signed-in' || reason === 'no-cdm' || reason === 'load-failed') {\n        var err = new Error('Amazon Music not ready');\n        err.notReady = true;\n        err.code = reason;\n        throw err;\n      }\n      return [];\n    }\n    var tracks = result.tracks || [];\n    return tracks.map(function(t) {\n      return {\n        id: 'amazonmusic-' + t.asin,\n        title: t.title,\n        artist: t.artist,\n        album: t.album,\n        duration: t.duration || 0,\n        sources: ['amazonmusic'],\n        amazonAsin: t.asin,\n        amazonUniqueId: t.uniqueId,\n        genre: t.genre || null,\n        explicit: !!t.explicit\n      };\n    });\n  } catch (error) {\n    if (error && error.notReady) throw error;\n    console.error('Amazon Music search error:', error);\n    return [];\n  }\n}",
    "resolve": "async function(artist, track, album, config) { var norm = function(s) { s = (s || '').toString().toLowerCase(); try { s = s.normalize('NFKD'); } catch (e) {} return s.replace(/\\p{M}/gu, '').replace(/[^\\p{L}\\p{N}]/gu, ''); }; var contains = function(a, b) { return !!a && !!b && (a.indexOf(b) !== -1 || b.indexOf(a) !== -1); }; var targetArtist = norm(artist); var targetTitle = norm(track); console.log('[Amazon] resolver resolve', artist, track, 'norm', targetArtist, targetTitle); var results = await this.search({ title: track, artist: artist }, config); console.log('[Amazon] resolver hits', results.length, results.slice(0, 3).map(function(r) { return (r.artist || '') + ' — ' + (r.title || ''); })); if (results.length === 0) return null; for (var i = 0; i < results.length; i++) { if (contains(norm(results[i].artist), targetArtist) && contains(norm(results[i].title), targetTitle)) return results[i]; } return null; }",
    "play": "async function(track, config) {\n  try {\n    if (!window.electron || !window.electron.amazonMusic) {\n      console.error('Amazon Music: bridge not available');\n      return false;\n    }\n    var asin = track.amazonAsin || track.asin;\n    if (!asin) {\n      console.error('Amazon Music: no ASIN on track');\n      return false;\n    }\n    var attempt = function() {\n      return window.electron.amazonMusic.playTrack({ asin: asin, title: track.title, artist: track.artist });\n    };\n    var result = await attempt();\n    if (result && result.success) return true;\n    var reason = result && result.reason;\n    if (reason === 'not-ready' || reason === 'not-signed-in' || reason === 'no-cdm') {\n      console.log('Amazon Music: not connected (' + reason + '), asking you to sign in...');\n      var managed = false;\n      if (typeof window.__parachordManageAmazonMusic === 'function') {\n        managed = await window.__parachordManageAmazonMusic({ explicit: true, reason: reason });\n      }\n      if (!managed) return false;\n      result = await attempt();\n      return !!(result && result.success);\n    }\n    console.error('Amazon Music play failed:', result && result.error);\n    return false;\n  } catch (error) {\n    console.error('Amazon Music play error:', error);\n    return false;\n  }\n}",
    "init": "async function(config) { console.log('Amazon Music resolver initialized'); return true; }",
    "cleanup": "async function() { console.log('Amazon Music resolver cleanup'); try { if (window.electron && window.electron.amazonMusic && window.electron.amazonMusic.polling) { window.electron.amazonMusic.polling.stop(); } } catch (e) {} }",
    "lookupPlaylist": "async function(url, config) {\n  var mapResult = function(p) {\n    return {\n      id: 'amazonmusic-playlist-' + (p.id || ''),\n      name: p.name || 'Amazon Music Playlist',\n      owner: p.owner || null,\n      albumArt: p.albumArt || null,\n      // The bridge reports the playlist's own trackCount; keep it so a\n      // server-truncated import is visible instead of silently complete.\n      trackCount: p.trackCount || p.tracks.length,\n      url: url,\n      tracks: p.tracks.map(function(t) {\n        return {\n          id: 'amazonmusic-' + t.asin,\n          title: t.title,\n          artist: t.artist,\n          album: t.album,\n          duration: t.duration || 0,\n          sources: ['amazonmusic'],\n          amazonAsin: t.asin,\n          albumAsin: t.albumAsin || null\n        };\n      })\n    };\n  };\n  var loaded = function(result) {\n    return !!(result && result.success && result.playlist && result.playlist.tracks && result.playlist.tracks.length > 0);\n  };\n  var result = null;\n  try {\n    if (!window.electron || !window.electron.amazonMusic) {\n      console.warn('Amazon Music: bridge not available');\n      return null;\n    }\n    result = await window.electron.amazonMusic.lookupPlaylist(url);\n    console.log('[Amazon] resolver playlist lookup', url, result && result.success, result && result.reason, result && result.playlist && result.playlist.tracks && result.playlist.tracks.length);\n    if (loaded(result)) return mapResult(result.playlist);\n    // Only a sign-in problem is fixed by sign-in. load-failed is a network\n    // condition and no-cdm is a playback problem - importing needs neither -\n    // and prompting for sign-in on either points the user at the wrong fix.\n    if (result && result.reason === 'not-signed-in') {\n      console.log('Amazon Music: not signed in, asking you to sign in...');\n      var managed = false;\n      if (typeof window.__parachordManageAmazonMusic === 'function') {\n        managed = await window.__parachordManageAmazonMusic({ explicit: true, reason: 'not-signed-in' });\n      }\n      if (managed) {\n        result = await window.electron.amazonMusic.lookupPlaylist(url);\n        if (loaded(result)) return mapResult(result.playlist);\n      }\n      var err = new Error('Amazon Music is not signed in - sign in from Settings to import playlists');\n      err.notReady = true;\n      err.code = 'not-signed-in';\n      throw err;\n    }\n  } catch (error) {\n    if (error && error.notReady) throw error;\n    console.error('Amazon Music playlist lookup error:', error);\n    return null;\n  }\n  // Outside the try so the catch does not swallow these.\n  // Transient/wiring failures first: a stalled load must not be reported as a\n  // missing playlist (or offered a sign-in prompt) - it is a network condition.\n  var reason = result && result.reason;\n  if (reason === 'load-failed' || reason === 'no-cdm' || reason === 'not-ready') {\n    var transientErr = new Error('Amazon Music is not reachable right now - check your connection and try again');\n    transientErr.notReady = true;\n    transientErr.code = reason;\n    throw transientErr;\n  }\n  if (result && result.success && result.playlist === null) {\n    throw new Error('Playlist not found on Amazon Music. It may have been deleted or made private.');\n  }\n  if (result && result.error) {\n    throw new Error('Amazon Music playlist import failed: ' + result.error);\n  }\n  if (result && result.success) {\n    throw new Error('Playlist not found on Amazon Music. It may have been deleted or made private.');\n  }\n  return null;\n}"
  }
}
