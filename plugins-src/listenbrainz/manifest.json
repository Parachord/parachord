{
  "manifest": {
    "id": "listenbrainz",
    "name": "ListenBrainz",
    "type": "meta-service",
    "version": "1.6.0",
    "author": "Parachord Team",
    "description": "Open-source music listening data and recommendations powered by your ListenBrainz history",
    "icon": "\ud83c\udfb5",
    "color": "#353070",
    "homepage": "https://listenbrainz.org"
  },
  "capabilities": {
    "recommendations": true,
    "historyMixes": true,
    "urlLookup": true,
    "similarUsers": true,
    "metadata": true,
    "listeningHistory": true
  },
  "urlPatterns": [
    "listenbrainz.org/playlist/*",
    "*.listenbrainz.org/playlist/*"
  ],
  "settings": {
    "requiresAuth": true,
    "authType": "token",
    "configurable": {
      "username": {
        "type": "text",
        "label": "ListenBrainz Username",
        "required": true
      },
      "userToken": {
        "type": "text",
        "label": "User Token",
        "required": false,
        "advanced": true,
        "description": "Required for submitting listens and accessing private data"
      }
    }
  }
}
