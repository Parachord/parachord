{
  "manifest": {
    "id": "bandcamp",
    "name": "Bandcamp",
    "version": "1.4.4",
    "author": "Parachord Team",
    "description": "Find, play and purchase music on Bandcamp, through Bandcamp's own player.",
    "icon": "🎸",
    "color": "#629AA9",
    "homepage": "https://bandcamp.com",
    "email": "support@harmonix.app",
    "minAppVersion": {
      "desktop": "0.9.13"
    }
  },
  "capabilities": {
    "resolve": true,
    "search": true,
    "stream": false,
    "browse": false,
    "urlLookup": true,
    "purchase": true,
    "albumSearch": true,
    "embedPlayer": true
  },
  "embedPlayer": {
    "adapter": "bandcamp-embed"
  },
  "urlPatterns": [
    "*.bandcamp.com/track/*",
    "*.bandcamp.com/album/*"
  ],
  "settings": {
    "requiresAuth": false,
    "authType": "none",
    "configurable": {}
  }
}
