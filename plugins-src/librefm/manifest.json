{
  "manifest": {
    "id": "librefm",
    "name": "Libre.fm",
    "type": "meta-service",
    "version": "1.0.1",
    "author": "Parachord Team",
    "description": "Scrobble what you play to Libre.fm, an open-source alternative to Last.fm.",
    "requirement": "Needs a Libre.fm account.",
    "icon": "🎵",
    "color": "#4CAF50",
    "homepage": "https://libre.fm"
  },
  "capabilities": {
    "scrobbling": true
  },
  "settings": {
    "requiresAuth": true,
    "authType": "oauth",
    "configurable": {
      "username": {
        "type": "text",
        "label": "Libre.fm Username",
        "required": false
      }
    }
  }
}
