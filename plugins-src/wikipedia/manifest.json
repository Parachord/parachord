{
  "manifest": {
    "id": "wikipedia",
    "name": "Wikipedia",
    "type": "meta-service",
    "version": "1.1.1",
    "author": "Parachord Team",
    "description": "Artist biographies and photos from Wikipedia.",
    "icon": "📚",
    "color": "#000000",
    "homepage": "https://www.wikipedia.org"
  },
  "capabilities": {
    "metadata": true,
    "biography": true,
    "artistImages": true
  },
  "biography": {
    "preferred": true
  },
  "settings": {
    "requiresAuth": false,
    "authType": "none",
    "configurable": {}
  }
}
