{
  "manifest": {
    "id": "ticketmaster",
    "name": "Ticketmaster",
    "type": "meta-service",
    "version": "1.0.4",
    "author": "Parachord Team",
    "description": "Concerts and live events, with links to buy tickets.",
    "requirement": "Needs your own free Ticketmaster API key.",
    "icon": "🎟️",
    "color": "#026CDF",
    "homepage": "https://www.ticketmaster.com"
  },
  "capabilities": {
    "concerts": true
  },
  "settings": {
    "requiresAuth": true,
    "authType": "apikey",
    "configurable": {
      "apiKey": {
        "type": "text",
        "label": "API key",
        "description": "Your Ticketmaster API key.",
        "placeholder": "your-api-key",
        "required": true,
        "helpUrl": "https://developer.ticketmaster.com/"
      }
    }
  }
}
