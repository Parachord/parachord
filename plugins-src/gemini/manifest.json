{
  "manifest": {
    "id": "gemini",
    "name": "Google Gemini",
    "type": "meta-service",
    "version": "2.3.4",
    "author": "Parachord Team",
    "description": "Ask Shuffleupagus for playlists and talk music with it, using Google Gemini.",
    "requirement": "Needs your own Google AI Studio API key.",
    "icon": "✦",
    "color": "#4285f4",
    "homepage": "https://ai.google.dev"
  },
  "capabilities": {
    "generate": true,
    "chat": true
  },
  "settings": {
    "requiresAuth": true,
    "authType": "apikey",
    "configurable": {
      "apiKey": {
        "type": "password",
        "label": "API key",
        "description": "Your Google AI Studio API key. Choose Create API key there; Gemini is turned on for its project.",
        "placeholder": "AIza…",
        "helpUrl": "https://aistudio.google.com/app/apikey"
      },
      "model": {
        "type": "dynamic-select",
        "label": "Model",
        "default": "gemini-2.5-flash",
        "fallbackOptions": [
          {
            "value": "gemini-2.5-flash",
            "label": "Gemini 2.5 Flash"
          },
          {
            "value": "gemini-2.5-pro",
            "label": "Gemini 2.5 Pro"
          }
        ]
      }
    }
  }
}
