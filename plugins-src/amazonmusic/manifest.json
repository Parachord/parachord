{
  "manifest": {
    "id": "amazonmusic",
    "name": "Amazon Music",
    "version": "1.21.4",
    "minAppVersion": {
      "desktop": "0.9.13"
    },
    "author": "Parachord Team",
    "description": "Search and play Amazon Music in Parachord, without the Amazon Music app.",
    "requirement": "Needs Amazon Music Unlimited. With Prime, Amazon gives Parachord art and links only.",
    "icon": "\ud83c\udfb5",
    "color": "#25D1DA",
    "homepage": "https://music.amazon.com",
    "email": "support@parachord.dev"
  },
  "capabilities": {
    "resolve": true,
    "search": true,
    "stream": true,
    "browse": false,
    "urlLookup": true,
    "albumSearch": true,
    "artistImage": true,
    "widevine": true,
    "mobile": false,
    "recommendations": true,
    "status": true
  },
  "urlPatterns": [
    "music.amazon.com/playlists/*",
    "music.amazon.com/my/playlists/*",
    "music.amazon.com/user-playlists/*",
    "music.amazon.com/albums/*"
  ],
  "urlTypes": {
    "track": [
      "music.amazon.com/albums/*?trackAsin=*",
      "music.amazon.com/albums/*?*trackAsin=*"
    ],
    "album": [
      "music.amazon.com/albums/*"
    ],
    "playlist": [
      "music.amazon.com/playlists/*",
      "music.amazon.com/my/playlists/*",
      "music.amazon.com/user-playlists/*"
    ]
  },
  "requires": {
    "hostBridges": [
      "webSession"
    ],
    "optionalHostBridges": [
      "widevine"
    ]
  },
  "settings": {
    "requiresAuth": false,
    "authType": "web-session",
    "configurable": {}
  }
}
