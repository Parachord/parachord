{
  "manifest": {
    "id": "seatgeek",
    "name": "SeatGeek",
    "type": "meta-service",
    "version": "1.0.3",
    "author": "Parachord Team",
    "description": "Concerts and live events, with links to buy tickets.",
    "requirement": "Needs your own free SeatGeek client ID.",
    "icon": "🎫",
    "color": "#FC4C02",
    "homepage": "https://seatgeek.com"
  },
  "capabilities": {
    "concerts": true
  },
  "settings": {
    "requiresAuth": true,
    "authType": "apikey",
    "configurable": {
      "clientId": {
        "type": "text",
        "label": "Client ID",
        "description": "Your SeatGeek API client ID.",
        "placeholder": "your-client-id",
        "required": true,
        "helpUrl": "https://seatgeek.com/account/develop"
      }
    }
  }
}
