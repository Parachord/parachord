{
  "manifest": {
    "id": "soundcloud",
    "name": "SoundCloud",
    "version": "1.3.7",
    "author": "Parachord Team",
    "description": "Search and stream SoundCloud.",
    "requirement": "Needs a SoundCloud account. Sign in from its panel.",
    "icon": "☁",
    "color": "#FF5500",
    "homepage": "https://soundcloud.com",
    "email": "support@parachord.dev",
    "minAppVersion": {
      "desktop": "0.9.13"
    }
  },
  "capabilities": {
    "resolve": true,
    "search": true,
    "stream": true,
    "browse": false,
    "urlLookup": true,
    "embedPlayer": true,
    "resolvePicks": true
  },
  "embedPlayer": {
    "adapter": "soundcloud-widget"
  },
  "urlPatterns": [
    "soundcloud.com/*",
    "*.soundcloud.com/*"
  ],
  "urlTypes": {
    "playlist": [
      "soundcloud.com/*/sets/*",
      "*.soundcloud.com/*/sets/*"
    ],
    "track": [
      "on.soundcloud.com/*",
      "soundcloud.com/*/*",
      "*.soundcloud.com/*/*"
    ],
    "artist": [
      "soundcloud.com/*",
      "*.soundcloud.com/*"
    ]
  },
  "settings": {
    "requiresAuth": true,
    "authType": "oauth",
    "configurable": {
      "clientId": {
        "type": "text",
        "label": "Client ID",
        "advanced": true
      },
      "clientSecret": {
        "type": "text",
        "label": "Client Secret",
        "advanced": true
      }
    }
  }
}
