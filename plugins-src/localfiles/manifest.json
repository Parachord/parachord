{
  "manifest": {
    "id": "localfiles",
    "name": "Local Files",
    "version": "1.2.0",
    "author": "Parachord Team",
    "description": "Play the music files on your computer.",
    "requirement": "Choose the folders your music is in.",
    "icon": "📁",
    "color": "#6366f1",
    "homepage": "",
    "email": ""
  },
  "capabilities": {
    "resolve": true,
    "search": true,
    "stream": true,
    "browse": false,
    "urlLookup": false,
    "albumSearch": true,
