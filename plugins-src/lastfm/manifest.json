{
  "manifest": {
    "id": "lastfm",
    "name": "Last.fm",
    "type": "meta-service",
    "version": "1.2.5",
    "author": "Parachord Team",
    "description": "Scrobble what you play to Last.fm, and get recommendations from your listening history.",
    "requirement": "Needs your Last.fm username.",
    "icon": "🎧",
    "color": "#D51007",
    "homepage": "https://last.fm"
  },
  "capabilities": {
    "scrobbling": true,
    "recommendations": true,
    "similarUsers": true,
    "metadata": true,
    "lovedTracks": true
  },
  "settings": {
    "requiresAuth": true,
    "authType": "username",
    "configurable": {
      "username": {
        "type": "text",
        "label": "Last.fm Username",
        "required": true
      },
      "apiKey": {
        "type": "text",
        "label": "API Key",
        "advanced": true
      },
      "apiSecret": {
        "type": "text",
        "label": "API Secret",
        "advanced": true
      }
    }
  }
}
